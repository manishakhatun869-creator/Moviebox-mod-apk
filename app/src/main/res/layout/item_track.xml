<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/trackRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:paddingTop="@dimen/space_sm"
    android:paddingBottom="@dimen/space_sm">

    <ImageView
        android:id="@+id/art"
        android:layout_width="@dimen/art_thumb"
        android:layout_height="@dimen/art_thumb"
        android:background="@drawable/bg_art_placeholder"
        android:contentDescription="@string/now_playing"
        android:padding="12dp"
        android:src="@drawable/ic_music_note"
        app:tint="@color/primary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/title"
        style="@style/TextAppearance.TowfikMusic.TrackTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_marginEnd="@dimen/space_sm"
        app:layout_constraintStart_toEndOf="@id/art"
        app:layout_constraintEnd_toStartOf="@id/addBtn"
        app:layout_constraintTop_toTopOf="@id/art"
        app:layout_constraintBottom_toTopOf="@id/artist"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/artist"
        style="@style/TextAppearance.TowfikMusic.Caption"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_marginEnd="@dimen/space_sm"
        android:layout_marginTop="2dp"
        app:layout_constraintStart_toEndOf="@id/art"
        app:layout_constraintEnd_toStartOf="@id/addBtn"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintBottom_toTopOf="@id/duration" />

    <TextView
        android:id="@+id/duration"
        style="@style/TextAppearance.TowfikMusic.Caption"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_marginEnd="@dimen/space_sm"
        android:layout_marginTop="2dp"
        app:layout_constraintStart_toEndOf="@id/art"
        app:layout_constraintEnd_toStartOf="@id/addBtn"
        app:layout_constraintTop_toBottomOf="@id/artist"
        app:layout_constraintBottom_toBottomOf="@id/art" />

    <ImageView
        android:id="@+id/addBtn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/playlist_add_to"
        android:padding="8dp"
        android:src="@drawable/ic_add"
        app:tint="@color/on_surface_muted"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
