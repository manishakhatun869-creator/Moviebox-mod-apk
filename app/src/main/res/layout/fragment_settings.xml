<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_md">

        <TextView
            style="@style/TextAppearance.TowfikMusic.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title" />

        <TextView
            style="@style/TextAppearance.TowfikMusic.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/settings_playback" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TowfikMusic.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowEqualizer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_md">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/settings_equalizer"
                        android:src="@drawable/ic_equalizer"
                        app:tint="@color/primary" />

                    <TextView
                        style="@style/TextAppearance.TowfikMusic.TrackTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:text="@string/settings_equalizer" />

                    <ImageView
                        android:id="@+id/lockEqualizer"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/premium_locked_badge"
                        android:src="@drawable/ic_lock" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/outline" />

                <LinearLayout
                    android:id="@+id/rowSpeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_md">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/settings_speed"
                        android:src="@drawable/ic_timer"
                        app:tint="@color/primary" />

                    <TextView
                        style="@style/TextAppearance.TowfikMusic.TrackTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:text="@string/settings_speed" />

                    <ImageView
                        android:id="@+id/lockSpeed"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/premium_locked_badge"
                        android:src="@drawable/ic_lock" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/outline" />

                <LinearLayout
                    android:id="@+id/rowSleep"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_md">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/settings_sleep_timer"
                        android:src="@drawable/ic_timer"
                        app:tint="@color/primary" />

                    <TextView
                        style="@style/TextAppearance.TowfikMusic.TrackTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:text="@string/settings_sleep_timer" />

                    <ImageView
                        android:id="@+id/lockSleep"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/premium_locked_badge"
                        android:src="@drawable/ic_lock" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/outline" />

                <LinearLayout
                    android:id="@+id/rowTheme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_md">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/settings_theme"
                        android:src="@drawable/ic_palette"
                        app:tint="@color/primary" />

                    <TextView
                        style="@style/TextAppearance.TowfikMusic.TrackTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:text="@string/settings_theme" />

                    <ImageView
                        android:id="@+id/lockTheme"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/premium_locked_badge"
                        android:src="@drawable/ic_lock" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/TextAppearance.TowfikMusic.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/settings_about" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TowfikMusic.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:layout_marginBottom="@dimen/space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <TextView
                    android:id="@+id/versionText"
                    style="@style/TextAppearance.TowfikMusic.TrackTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_version"
                    android:textStyle="bold" />

                <TextView
                    style="@style/TextAppearance.TowfikMusic.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/settings_legal" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
